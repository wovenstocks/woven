{
  "name": "woven-protocol",
  "version": "0.1.0",
  "description": "Redeemable ERC-20 bStock baskets with atomic USDC routing on BNB Chain.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets:images": "node scripts/generate-image-assets.mjs",
    "assets:check": "node scripts/generate-image-assets.mjs --check && node scripts/render-brand-assets.mjs --check",
    "brand:render": "node scripts/render-brand-assets.mjs",
    "brand:check": "node scripts/render-brand-assets.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build -- --mode e2e && playwright test",
    "contracts:fmt": "forge fmt --check --root contracts",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "release:evidence": "node scripts/create-release-evidence.mjs",
    "release:console": "node tools/release-console/server.mjs",
    "release:console:prepare": "node tools/release-console/prepare-manifest.mjs",
    "safe:prepare": "node scripts/prepare-safe.mjs",
    "launch:verify": "node scripts/verify-launch-profile.mjs",
    "bstocks:verify": "node scripts/verify-bstocks.mjs",
    "verify": "npm run lint && npm run format:check && npm run assets:check && npm test && npm run build && npm run test:e2e && npm run contracts:fmt && npm run contracts:test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "lucide-react": "^1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "^16.27.0",
    "viem": "^2.55.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cyclonedx/cyclonedx-library": "10.1.0",
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@eslint/js": "9.39.5",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
